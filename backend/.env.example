NODE_ENV=production
PORT=4000

# Neon Postgres (pooled + direct)
DATABASE_URL=
DIRECT_URL=

FIELD_ENCRYPTION_KEY=
JWT_SECRET=

# Comma-separated Google emails that can open the staff console
STAFF_EMAILS=
STAFF_READONLY_EMAILS=

# Google Identity Services (Web client ID). Required for live sign-in.
GOOGLE_CLIENT_ID=

# Public origins. API_URL is the Render URL from the dashboard (https://….onrender.com)
# not localhost.
CORS_ORIGINS=https://digital26.online,https://www.digital26.online
APP_URL=https://www.digital26.online
PUBLIC_SITE_URL=https://www.digital26.online
API_URL=

# Optional hidden console path
CONSOLE_PATH=

# Mail: Resend on Render (SMTP ports are blocked on the free plan)
RESEND_API_KEY=
EMAIL_FROM=The Digital 26 <noreply@digital26.online>

# Bachs live payments only (sk_live_…)
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_API_BASE=https://api.bachs.io

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=digital26/students

# Daily quiz + news (written by cron, not by visitors)
GROQ_API_KEY=
GNEWS_API_KEY=
CRON_SECRET=

# Optional
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b
# NEON_AUTH_URL=
# NEON_AUTH_JWKS_URL=
