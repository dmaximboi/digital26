generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DealType {
  BUY_PRODUCT
  LEARN_SKILLS
  OTHER
}

enum CertificateType {
  PARTICIPATION
  COMPLETION
}

enum CertificateStatus {
  PENDING
  VALID
  REVOKED
}

model Person {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  agreements   Agreement[]
  certificates Certificate[]

  @@map("people")
}

model Agreement {
  id              String    @id @default(cuid())
  personId        String    @map("person_id")
  dealType        DealType  @map("deal_type")
  otherDealText   String?   @map("other_deal_text")
  termsSnapshot   String    @map("terms_snapshot") @db.Text
  signatureName   String?   @map("signature_name")
  signedAt        DateTime? @map("signed_at")
  passkeyHash     String    @map("passkey_hash")
  sessionId       String    @unique @map("session_id")
  linkExpiresAt   DateTime  @map("link_expires_at")
  consumedAt      DateTime? @map("consumed_at")
  ninEncrypted    String?   @map("nin_encrypted")
  photoUrl        String?   @map("photo_url")
  pdfUrl          String?   @map("pdf_url")
  publicId        String?   @unique @map("public_id")
  requestingIp    String?   @map("requesting_ip")
  passkeyAttempts Int       @default(0) @map("passkey_attempts")
  lockedUntil     DateTime? @map("locked_until")
  templatePngDownloadedAt DateTime? @map("template_png_downloaded_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  person Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  public AgreementPublic?
  evidence EvidenceImage[]

  @@index([sessionId])
  @@index([linkExpiresAt])
  @@map("agreements")
}

model AgreementPublic {
  id            String   @id @default(cuid())
  publicId      String   @unique @map("public_id")
  agreementId   String   @unique @map("agreement_id")
  displayName   String   @map("display_name")
  dealType      DealType @map("deal_type")
  dealTag       String?  @map("deal_tag") @db.VarChar(50)
  signedAt      DateTime @map("signed_at")
  signatureName String   @map("signature_name")
  createdAt     DateTime @default(now()) @map("created_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@map("agreements_public")
}

model Certificate {
  id             String            @id @default(cuid())
  personId       String?           @map("person_id")
  publicId       String?           @unique @map("public_id")
  type           CertificateType
  course         String
  issueDate      DateTime          @map("issue_date")
  status         CertificateStatus @default(VALID)
  photoUrl       String?           @map("photo_url")
  pdfUrl         String?           @map("pdf_url")
  inviteEmail    String?           @map("invite_email")
  claimSessionId String?           @unique @map("claim_session_id")
  claimExpiresAt DateTime?         @map("claim_expires_at")
  claimedAt      DateTime?         @map("claimed_at")
  templatePngDownloadedAt DateTime? @map("template_png_downloaded_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  person Person?             @relation(fields: [personId], references: [id], onDelete: Restrict)
  public CertificatePublic?
  evidence EvidenceImage[]

  @@index([claimSessionId])
  @@index([publicId])
  @@map("certificates")
}

model CertificatePublic {
  id            String            @id @default(cuid())
  publicId      String            @unique @map("public_id")
  certificateId String            @unique @map("certificate_id")
  displayName   String            @map("display_name")
  course        String
  type          CertificateType
  issueDate     DateTime          @map("issue_date")
  status        CertificateStatus
  photoUrl      String?           @map("photo_url")
  createdAt     DateTime          @default(now()) @map("created_at")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("certificates_public")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String   @map("admin_email")
  action     String
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminEmail])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model IdSequence {
  name  String @id
  value Int    @default(0)

  @@map("id_sequences")
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    @map("code_hash")
  purpose    String
  sessionId  String?   @map("session_id")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([sessionId])
  @@map("email_otps")
}

model AdminAllowlist {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  role      String   @default("FULL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_allowlist")
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  body      String    @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([readAt])
  @@map("contact_messages")
}

model SiteVisit {
  id        String   @id @default(cuid())
  ip        String
  path      String
  referrer  String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([ip])
  @@index([path])
  @@map("site_visits")
}

enum EvidenceKind {
  AGREEMENT_ADMIN_PROOF
  AGREEMENT_CLIENT_PROOF
  CERT_ADMIN_SOLO
  CERT_STUDENT_SOLO
  CERT_ADMIN_STUDENT
  CERT_STUDENT_EVIDENCE
}

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProgrammeType {
  THREE_MONTH
  FOUR_MONTH
  FIVE_MONTH
  SIX_MONTH
  CUSTOM
}

enum ClassMode {
  PHYSICAL
  ONLINE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  googleId  String?  @unique @map("google_id")
  role      String   @default("STUDENT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      StudentProfile?
  attendance   Attendance[]
  chatMessages ChatMessage[]

  @@map("users")
}

model StudentProfile {
  id              String        @id @default(cuid())
  userId          String        @unique @map("user_id")
  fullName        String        @map("full_name")
  phone           String
  photoUrl        String?       @map("photo_url")
  parentPhone     String?       @map("parent_phone")
  address         String?       @db.Text
  programme       ProgrammeType
  customMonths    Int?          @map("custom_months")
  classMode       ClassMode     @default(PHYSICAL) @map("class_mode")
  status          StudentStatus @default(PENDING)
  reviewedAt      DateTime?     @map("reviewed_at")
  reviewedBy      String?       @map("reviewed_by")
  rejectionNote   String?       @map("rejection_note") @db.Text
  startDate       DateTime?     @map("start_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  messages   StudentMessage[]

  @@map("student_profiles")
}

model StudentMessage {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  fromAdmin Boolean  @default(false) @map("from_admin")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@map("student_messages")
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  profileId  String   @map("profile_id")
  weekNumber Int      @map("week_number")
  signedAt   DateTime @default(now()) @map("signed_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, weekNumber])
  @@index([userId])
  @@map("attendance")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@map("chat_messages")
}

model EvidenceImage {
  id            String       @id @default(cuid())
  kind          EvidenceKind
  url           String
  phoneHint     String?      @map("phone_hint")
  agreementId   String?      @map("agreement_id")
  certificateId String?      @map("certificate_id")
  uploadedBy    String       @map("uploaded_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  agreement   Agreement?   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([certificateId])
  @@index([kind])
  @@map("evidence_images")
}
